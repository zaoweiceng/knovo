[Unit]
Description=Knovo personal knowledge library
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/knovo/app
EnvironmentFile=%h/knovo/knowledge.env
ExecStart=/usr/bin/node %h/knovo/app/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
